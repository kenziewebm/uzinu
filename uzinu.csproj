<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="external/**/*.cs" />
    <EmbeddedResource Remove="external/**/*" />
    <None Remove="external/**/*" />
  </ItemGroup>

  <ItemGroup>
	  <ProjectReference Include="external/UndertaleModTool/UndertaleModLib/UndertaleModLib.csproj" />
	  <ProjectReference Include="external/UndertaleModTool/Underanalyzer/Underanalyzer/Underanalyzer.csproj" />
  </ItemGroup>

</Project>
